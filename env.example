# ── Telegram credentials (required) ──────────────────────────────────────────
# Get API_ID and API_HASH from https://my.telegram.org
API_ID=123456
API_HASH=your_api_hash_here

# Create a bot at https://t.me/BotFather and paste the token here
BOT_TOKEN=123456:ABCdef...

# ── Channels (required) ───────────────────────────────────────────────────────
# A private Telegram channel where files are cached.
# The bot must be an admin with "Post Messages" permission.
# Use a negative ID like -1001234567890 (get it by forwarding a message to @userinfobot)
DB_CHANNEL=-1001234567890

# ── Access control (optional) ─────────────────────────────────────────────────
# Comma-separated Telegram user IDs that can use admin commands (/broadcast).
# Leave empty to make the bot fully public.
ADMIN_IDS=123456789,987654321

# ── File splitting (optional) ─────────────────────────────────────────────────
# Max size per part in MB before splitting a file into multiple parts.
# Default is 2000 MB (just under Telegram's 2 GB bot upload limit).
# Lower this if you want smaller parts (e.g. 1900 for extra safety margin).
SPLIT_SIZE=2000

# ── Ads (optional) ────────────────────────────────────────────────────────────
# If set, this message is shown to users before their file is delivered.
AD_TEXT=🔥 Join our channel for more anime: @yourchannel

# Optional button attached to the ad message
AD_BUTTON_TEXT=Join Channel
AD_BUTTON_URL=https://t.me/yourchannel
